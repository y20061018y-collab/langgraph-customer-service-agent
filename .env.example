# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交，也不要发给任何人。

# ---------- 对话模型（llm.py，OpenAI 兼容接口）----------
# 必填。任何 OpenAI 兼容服务的 key（DeepSeek / 智谱 GLM / OpenAI 等）
LLM_API_KEY=
# 兼容接口地址；留空则走 OpenAI 官方。例：https://open.bigmodel.cn/api/paas/v4/
LLM_BASE_URL=
# 模型名；留空时 llm.py 默认 gpt-4o-mini。evals 报告使用的是 deepseek-v4-flash
LLM_MODEL_NAME=

# ---------- Embedding（rag.py）----------
# 提供方：zhipu（默认，智谱 embedding-3）| ollama（本地 Ollama，如 bge-m3）
# 换提供方 / 模型 / 维度后必须重建向量库：python scripts/build_kb.py --rebuild
# 切换 provider 时 EMBEDDING_PROVIDER / EMBEDDING_MODEL_NAME / EMBEDDING_BASE_URL 三项必须一起改（只改 PROVIDER 会把请求发到智谱地址、用 embedding-3 的模型名）
# EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL_NAME=embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 智谱开放平台 key；留空时复用 LLM_API_KEY（ollama 不需要 key）
EMBEDDING_API_KEY=
# 可选：输出维度 256/512/1024/2048，默认 1024（只对 zhipu 生效；ollama 的维度由模型决定）
# EMBEDDING_DIMENSIONS=1024
# 可选：相似度阈值，低于它判为"未找到"，默认 0.25，设 0 关闭
# EMBEDDING_SIMILARITY_THRESHOLD=0.25
# 可选：embedding 请求超时（秒），默认 60；连接超时固定 10s
# EMBEDDING_TIMEOUT=60
#
# 改用本地 Ollama bge-m3 的示例（先在宿主机 ollama pull bge-m3）：
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=bge-m3
# 本地运行用 http://localhost:11434；docker compose 中访问宿主机用：
# EMBEDDING_BASE_URL=http://host.docker.internal:11434

# ---------- PostgreSQL（docker compose 使用）----------
# docker compose 会用这三项初始化数据库，并自动拼出 app 的 DATABASE_URL
POSTGRES_USER=agent
# 必填，自己设一个密码
POSTGRES_PASSWORD=
POSTGRES_DB=agent_demo
# 宿主机上暴露的 API 端口
APP_PORT=8000

# ---------- 本地运行（不用 docker 时）----------
# SQLAlchemy 异步连接串：postgresql+asyncpg://用户:密码@主机:端口/库名
# 本地运行必填：未设置时 db.py 会在启动时报错（docker compose 会自动注入，无需填写）
# DATABASE_URL=postgresql+asyncpg://用户:密码@localhost:5432/agent_demo

# ---------- 会话记忆 ----------
# 每次请求最多携带的历史消息条数（滑动窗口），默认 10
MAX_HISTORY_MESSAGES=10
